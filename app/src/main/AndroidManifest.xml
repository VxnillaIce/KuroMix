<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Root-driven task/display management, no runtime prompt needed since
         everything privileged goes through the `su` shell via libsu. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".KuroMix"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="false"
        android:icon="@drawable/kuromify"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Marks this APK as an LSPosed/Xposed module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="KuroMix: keep-alive + rear display hooks for HyperOS" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <!-- LSPosed scope: this app itself, plus system_server / SystemUI
             for the keep-alive + rear-display-center hooks. Configure the
             actual scope inside the LSPosed Manager app. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kuromix" android:host="switch" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MirrorTileService"
            android:label="Mirror to Rear"
            android:icon="@drawable/kuromify_logo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.UnmirrorTileService"
            android:label="Unmirror from Rear"
            android:icon="@drawable/kuromify_logo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.MirrorMonitorService"
            android:exported="false" />

        <receiver
            android:name=".receiver.KuroMixReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kuromify.kuromix.ACTION_STOP_MIRROR" />
            </intent-filter>
        </receiver>

        <service
            android:name=".notification.MediaSessionListenerService"
            android:label="KuroMix Media Listener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.KuroMixCloseReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kuromify.kuromix.CLOSE_LIVE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".notification.MediaSessionListenerService"
            android:label="KuroMix Media Listener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.KuroMixCloseReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kuromify.kuromix.CLOSE_LIVE" />
            </intent-filter>
        </receiver>

        <!-- Timer / Download HyperIsland action receiver -->
        <receiver
            android:name=".receiver.KuroMixLiveActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kuromify.kuromix.TIMER_PAUSE" />
                <action android:name="com.kuromify.kuromix.TIMER_RESUME" />
                <action android:name="com.kuromify.kuromix.TIMER_RESET" />
                <action android:name="com.kuromify.kuromix.DOWNLOAD_PAUSE" />
                <action android:name="com.kuromify.kuromix.DOWNLOAD_RESUME" />
                <action android:name="com.kuromify.kuromix.DOWNLOAD_RESET" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
